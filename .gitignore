# https://git-scm.com/docs/gitignore

# ---------------------------------------------------------------------
# DO NOT CHANGE THIS SECTION

# Dependencies
node_modules/

# Compiled output
dist/
build/
coverage/

# Generated at runtime
*.log
.cache

# Personal files
.idea

# System files
.DS_Store

# ---------------------------------------------------------------------
# Add specific rules here…

# TypeScript incremental build cache
*.tsbuildinfo

# Next.js
.next/
out/
.vercel
next-env.d.ts

# Environment (secrets — never commit)
.env
.env*.local

# Convex generated code
**/convex/_generated/
