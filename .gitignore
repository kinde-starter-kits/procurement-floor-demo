# https://git-scm.com/docs/gitignore

# ---------------------------------------------------------------------
# DO NOT CHANGE THIS SECTION

# Dependencies
node_modules/

# Compiled output
dist/
build/
coverage/

# Generated at runtime
*.log
.cache

# Personal files
.idea

# System files
.DS_Store

# ---------------------------------------------------------------------
# Add specific rules here…

# TypeScript incremental build cache
*.tsbuildinfo

# Next.js
.next/
out/
.vercel
next-env.d.ts

# Trigger.dev build cache
.trigger/

# Environment (secrets — never commit)
.env
.env*.local

# NOTE: convex/_generated is intentionally committed (not ignored). Convex's
# guidance is to commit generated code so the project typechecks without running
# the Convex CLI first — CI has no deploy key and never generates it. Regenerate
# it with `npx convex codegen` and commit it alongside any schema change.
